{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Items with durability no longer disappear when they break: like the elytra, they stay in the inventory as a broken, useless version until they are repaired.",
  "authors": [
    "Nico Welles"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.welles.itemrepair.ItemRepairFabric"
    ],
    "client": [
      "dev.welles.itemrepair.ItemRepairFabricClient"
    ],
    "modmenu": [
      "dev.welles.itemrepair.ItemRepairModMenu"
    ]
  },
  "mixins": [
    "itemrepair.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}"
  }
}
